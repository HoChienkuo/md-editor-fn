#!/bin/bash

APP_NAME="md-editor-fn"

NODEJS_DIR="/var/apps/nodejs_v22/target/bin"
NODE_BIN="${NODEJS_DIR}/node"

export PATH="${NODEJS_DIR}:${PATH}"

APP_DIR="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"

SERVER_FILE="${APP_DIR}/server/index.js"
SOCKET_FILE="${APP_DIR}/app.sock"

PID_FILE="${VAR_DIR}/${APP_NAME}.pid"
LOG_FILE="${VAR_DIR}/${APP_NAME}.log"

GATEWAY_PREFIX="/app/md-editor-fn"

log_msg() {
    mkdir -p "${VAR_DIR}"
    printf "%s - %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${LOG_FILE}"
}

read_pid() {
    if [ ! -r "${PID_FILE}" ]; then
        return 1
    fi

    PID="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"

    if [ -z "${PID}" ]; then
        return 1
    fi

    return 0
}

check_process() {
    local target_pid="$1"

    if [ -z "${target_pid}" ]; then
        return 1
    fi

    kill -0 "${target_pid}" 2>/dev/null
}

status_app() {
    if ! read_pid; then
        return 1
    fi

    if check_process "${PID}"; then
        return 0
    fi

    rm -f "${PID_FILE}"

    return 1
}

start_app() {
    mkdir -p "${VAR_DIR}"

    if status_app; then
        log_msg "Application is already running, pid=${PID}"
        return 0
    fi

    if [ ! -f "${SERVER_FILE}" ]; then
        log_msg "Server file does not exist: ${SERVER_FILE}"
        return 1
    fi

    if [ ! -x "${NODE_BIN}" ]; then
        fail_start "Node.js executable was not found or is not executable: ${NODE_BIN}"
        return 1
    fi

    rm -f "${PID_FILE}"
    rm -f "${SOCKET_FILE}"

    log_msg "Starting ${APP_NAME}"
    log_msg "Node.js binary: ${NODE_BIN}"
    log_msg "Node.js version: $("${NODE_BIN}" --version 2>&1)"
    log_msg "Server: ${SERVER_FILE}"
    log_msg "Socket: ${SOCKET_FILE}"

    APPLICATION_DIRECTORY="${APP_DIR}" \
    APPLICATION_DATA_DIRECTORY="${VAR_DIR}" \
    SOCKET_PATH="${SOCKET_FILE}" \
    GATEWAY_PREFIX="${GATEWAY_PREFIX}" \
    "${NODE_BIN}" "${SERVER_FILE}" >> "${LOG_FILE}" 2>&1 &

    local started_pid="$!"

    printf "%s" "${started_pid}" > "${PID_FILE}"

    local count=0

    while [ "${count}" -lt 10 ]; do
        if ! check_process "${started_pid}"; then
            log_msg "Application exited during startup"
            rm -f "${PID_FILE}"
            rm -f "${SOCKET_FILE}"
            return 1
        fi

        if [ -S "${SOCKET_FILE}" ]; then
            log_msg "Application started, pid=${started_pid}"
            return 0
        fi

        sleep 1
        count=$((count + 1))
    done

    log_msg "Application did not create its socket in time"

    kill -TERM "${started_pid}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    rm -f "${SOCKET_FILE}"

    return 1
}

stop_app() {
    log_msg "Stopping ${APP_NAME}"

    if ! read_pid; then
        log_msg "PID file does not exist"
        rm -f "${SOCKET_FILE}"
        return 0
    fi

    local target_pid="${PID}"

    if ! check_process "${target_pid}"; then
        log_msg "Process is not running, pid=${target_pid}"
        rm -f "${PID_FILE}"
        rm -f "${SOCKET_FILE}"
        return 0
    fi

    log_msg "Sending TERM to pid=${target_pid}"

    kill -TERM "${target_pid}" 2>/dev/null || true

    local count=0

    while check_process "${target_pid}" &&
          [ "${count}" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "${target_pid}"; then
        log_msg "Graceful shutdown timed out, sending KILL"

        kill -KILL "${target_pid}" 2>/dev/null || true
        sleep 1
    fi

    rm -f "${PID_FILE}"
    rm -f "${SOCKET_FILE}"

    log_msg "Application stopped"

    return 0
}

case "$1" in
    start)
        start_app
        exit $?
        ;;

    stop)
        stop_app
        exit $?
        ;;

    status)
        if status_app; then
            exit 0
        fi

        exit 3
        ;;

    *)
        printf "%s\n" "Unknown command: $1" > "${TRIM_TEMP_LOGFILE}"
        exit 1
        ;;
esac